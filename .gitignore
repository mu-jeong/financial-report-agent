# ── API 키 / 환경변수 ─────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── 다운로드된 PDF 파일 및 DB 데이터 (대용량, 개인 데이터) ──
data/*
!data/.gitkeep
!data/listed_company_industries.csv
reports/

# ── 로그 파일 ──
logs/*
!logs/.gitkeep

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# ── 가상환경 ─────────────────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── IDE / 에디터 ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db


.omx/
.hermes/

# V2 migration runtime and copied-install validation workspaces
/.v2m/
/.v2p/

# Local document rendering and editor scratch files
/docs/temp/
/.tmp_*/
~$*.docx

deliverables/

# Evaluation datasets and fixed snapshots are intentionally absent until the
# source data is complete and the baseline is reviewed.
tests/fixtures/
# ── 사용자 문제 신고 / 디버그 산출물 ─────────────────────────────────────────
debug/*
!debug/.gitkeep
