# Finance LLM environment template
# Generated from src/configs/settings.py. Do not edit defaults in multiple places.
# Copy this file to .env, then fill OPENROUTER_API_KEY.

# --- OpenRouter ---
# OpenRouter API key. Required for model and embedding calls.
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional app/site URL sent to OpenRouter rankings metadata.
OPENROUTER_APP_URL=
# Optional app title sent to OpenRouter rankings metadata.
OPENROUTER_APP_TITLE=finance_llm
# deny routes only to providers that do not collect user data; allow permits broader routing.
OPENROUTER_DATA_COLLECTION=deny

# --- Models ---
# Model used for answer generation, query rewriting, and SQL generation.
GENERATION_MODEL=deepseek/deepseek-v4-flash
# Embedding model used for FAISS indexing and search queries.
EMBEDDING_MODEL=baai/bge-m3

# --- Rerank ---
# Enable optional reranking. false is cheaper for Quick Start.
USE_RERANKER=false
# Rerank provider: openrouter or flashrank fallback.
RERANK_PROVIDER=openrouter
# OpenRouter rerank model when reranking is enabled.
RERANK_MODEL=cohere/rerank-v3.5
# Rerank request timeout in seconds.
RERANK_TIMEOUT=60.0
# Fetch SEARCH_TOP_K times this many candidates before reranking.
RERANK_CANDIDATE_MULTIPLIER=3

# --- Search ---
# Search score boost for newer reports.
RECENCY_WEIGHT=0.15
# Number of vector search results returned to the answer pipeline.
SEARCH_TOP_K=20

# --- Embedding ---
# Default embedding run limit. 0 processes every pending file.
TEST_LIMIT=10
# Parent chunk size for parent-child retrieval.
PARENT_CHUNK_SIZE=2000
# Child chunk size used for retrieval.
CHILD_CHUNK_SIZE=500
# Fallback/general text splitter chunk size.
CHUNK_SIZE=1500
# Fallback/general text splitter overlap size.
CHUNK_OVERLAP=150
# PDF extraction engine: pymupdf, marker, or opendataloader.
EXTRACTION_ENGINE=pymupdf
# Enable parent-child chunking.
USE_PARENT_CHILD=true

# --- Crawler ---
# LATEST uses the execution/target date as the search end date; SPECIFIC_DATE uses only target date logic.
CRAWLER_MODE=LATEST
# Report categories: company, industry, economy, comma-separated list, or all.
CRAWLER_CATEGORIES=company
# Search end date. Quick Start refreshes this to the execution date every run.
CRAWLER_TARGET_DATE=
# 0 means no count limit; positive values stop after that many processed reports.
CRAWLER_TARGET_COUNT=0
# Collect target date plus this many previous days. 7 means an 8-day inclusive window.
CRAWLER_LOOKBACK_DAYS=7
# Safety lookback window for count-based collection.
CRAWLER_MAX_LOOKBACK_DAYS=7

# --- Paths ---
# Directory used by the GUI to open referenced PDF files. Leave blank to use data/downloaded.
REPORT_PDF_DIR=
