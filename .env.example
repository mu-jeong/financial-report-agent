# Finance LLM environment template
# Generated from src/configs/settings.py. Do not edit defaults in multiple places.
# Copy this file to .env, then fill OPENROUTER_API_KEY.

# --- OpenRouter ---
# OpenRouter API key. Required for model and embedding calls.
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional app/site URL sent to OpenRouter rankings metadata.
OPENROUTER_APP_URL=
# Optional app title sent to OpenRouter rankings metadata.
OPENROUTER_APP_TITLE=finance_llm
# deny routes only to providers that do not collect user data; allow permits broader routing.
OPENROUTER_DATA_COLLECTION=deny

# --- Models ---
# Model used for answer generation, query rewriting, and SQL generation.
GENERATION_MODEL=deepseek/deepseek-v4-flash
# Embedding model used for FAISS indexing and search queries.
EMBEDDING_MODEL=baai/bge-m3

# --- Rerank ---
# Enable optional reranking. false is cheaper for Quick Start.
USE_RERANKER=false
# Rerank provider: openrouter or explicit local flashrank adapter.
RERANK_PROVIDER=openrouter
# OpenRouter rerank model when reranking is enabled.
RERANK_MODEL=cohere/rerank-v3.5
# Rerank request timeout in seconds.
RERANK_TIMEOUT=60.0

# --- Search ---
# Search score boost for newer reports.
RECENCY_WEIGHT=0.15
# Number of vector search results returned to the answer pipeline.
SEARCH_TOP_K=20
# Multiply SEARCH_TOP_K by this value when fetching candidates.
SEARCH_CANDIDATE_MULTIPLIER=1

# --- Embedding ---
# Parent chunk size for parent-child retrieval.
PARENT_CHUNK_SIZE=2000
# Child chunk size used for retrieval.
CHILD_CHUNK_SIZE=500
# Fallback/general text splitter chunk size.
CHUNK_SIZE=1500
# Fallback/general text splitter overlap size.
CHUNK_OVERLAP=150
# PDF parsing/extraction engine for normal embedding runs: pymupdf, opendataloader, docling, or pdf-to-markdown. Legacy env alias: EXTRACTION_ENGINE.
PDF_EXTRACTION_ENGINE=pymupdf
# Fallback PDF parsing/extraction engine used only when PDF_EXTRACTION_ENGINE fails. Set empty to disable fallback. Legacy env alias: EXTRACTION_FALLBACK_ENGINE.
PDF_EXTRACTION_FALLBACK_ENGINE=opendataloader
# PDF parsing/extraction engine used when embedding pending/unembedded reports. Set empty to reuse PDF_EXTRACTION_ENGINE. Legacy env alias: UNEMBEDDED_EXTRACTION_ENGINE.
UNEMBEDDED_PDF_EXTRACTION_ENGINE=pymupdf
# Enable parent-child chunking.
USE_PARENT_CHILD=true

# --- Crawler ---
# LATEST uses the crawler's KST current date; SPECIFIC_DATE uses CRAWLER_TARGET_DATE.
CRAWLER_MODE=LATEST
# Report categories: company, industry, economy, comma-separated list, or all.
CRAWLER_CATEGORIES=company
# Search end date. Quick Start refreshes this to the execution date every run.
CRAWLER_TARGET_DATE=
# 0 means no count limit; positive values stop after that many processed reports.
CRAWLER_TARGET_COUNT=0
# Collect target date plus this many previous days. 7 means an 8-day inclusive window.
CRAWLER_LOOKBACK_DAYS=7
# Safety lookback window for count-based collection.
CRAWLER_MAX_LOOKBACK_DAYS=7

# --- Optional path overrides (leave blank to use defaults) ---
# Optional override for the directory used by the GUI to open referenced PDF files. Leave blank to use <PROJECT_ROOT>/data/downloaded.
REPORT_PDF_DIR=
# Optional override for downloaded report PDFs and the V2 source inventory. Leave blank to use <PROJECT_ROOT>/data/downloaded.
SAVE_DIR=
# Optional override for the canonical Native V2 retrieval root. Leave blank to use <PROJECT_ROOT>/data; normal runtime derives its catalog and snapshot paths from this directory.
DATA_ROOT=
# Optional override for the FlashRank model cache. Leave blank to use <DATA_ROOT>/cache/flashrank.
RERANK_CACHE_DIR=
# Optional override for the SQLite conversation database path. Leave blank to use <PROJECT_ROOT>/data/conversations.db.
CONVERSATION_DB_PATH=
# Optional override for the KRX listed-company industry CSV used for sector/company universe lookup. Leave blank to use <PROJECT_ROOT>/data/listed_company_industries.csv.
COMPANY_INDUSTRY_DATA_PATH=

# --- Monitoring ---
# Enable the Streamlit Monitoring Mode UI for performance metric review.
MONITORING_MODE=false

# --- Issue reporting ---
# Allow user-approved issue reports to be queued for the operator-managed remote ingest endpoint.
ISSUE_REPORT_REMOTE_ENABLED=true
# Public Supabase Edge Function URL for central issue-report collection. Override only when using another deployment; set ISSUE_REPORT_REMOTE_ENABLED=false to disable submission.
ISSUE_REPORT_INGEST_URL=https://rjjnhvoontxpimhiabou.supabase.co/functions/v1/issue-report-ingest
# Public Supabase publishable key accepted by the issue-report Edge Function. This is not a secret; override it only when using another deployment.
ISSUE_REPORT_PUBLISHABLE_KEY=sb_publishable_O5bQ-b9VvY1fcwDz0IQlPg_prsFM87B
# Optional retry-only issue-report outbox path. Leave blank to use <DATA_ROOT>/issue-report-outbox. Report payloads are removed after delivery, rejection, or expiry.
ISSUE_REPORT_OUTBOX_DIR=
