OPENROUTER_API_KEY=your_openrouter_api_key_here
GENERATION_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_APP_TITLE=finance_llm
# deny = route only to providers that do not collect user data; allow = broader routing
OPENROUTER_DATA_COLLECTION=deny

EMBEDDING_MODEL=baai/bge-m3

USE_RERANKER=false
# Rerank provider: openrouter (default) or flashrank (local fallback).
RERANK_PROVIDER=openrouter
RERANK_MODEL=cohere/rerank-v3.5
# Higher values give newer reports more weight in search ranking.
RECENCY_WEIGHT=0.15

# LATEST uses CRAWLER_TARGET_DATE as the search end date, then looks back CRAWLER_LOOKBACK_DAYS.
# SPECIFIC_DATE collects only CRAWLER_TARGET_DATE.
CRAWLER_MODE=LATEST
# Values: company, industry, economy, comma-separated list, or all.
CRAWLER_CATEGORIES=company
CRAWLER_TARGET_DATE=2026-05-31
# Stop after this many processed reports. 0 disables count-based collection.
CRAWLER_TARGET_COUNT=0
# Collect reports from the end date back N days. 0 means exact/latest date only unless CRAWLER_TARGET_COUNT is set.
CRAWLER_LOOKBACK_DAYS=0
# Safety window used when CRAWLER_TARGET_COUNT is set and CRAWLER_LOOKBACK_DAYS=0.
CRAWLER_MAX_LOOKBACK_DAYS=30
